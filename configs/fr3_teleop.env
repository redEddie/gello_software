# Runtime settings for FR3 GELLO teleop.  Source before launching:
#
#     source configs/fr3_teleop.env
#     python experiments/run_env.py --agent gello
#
# Sourcing is optional: unset variables fall back to the defaults below.

# Reset (home) pose that run_env.py drives the FR3 to before teleop starts.
# `--reset-pose <name>` on the command line overrides this, which is the handier
# way to try several poses in a row:
#
#     python experiments/run_env.py --agent gello --reset-pose libero
#
# Poses mirror dsfranka's configs/teleop.yaml `home.presets` (which still spells
# `panda` as `dsfranka` and `fr3_ready` as `franka_ready`):
#
#   panda     : menagerie fr3_hand/panda "home" keyframe, matches the sim model.
#               q4 = -pi/2.  (default)
#   fr3_ready : Franka's built-in "ready" pose -- where the arm boots to and
#               where Desk's "move to start" parks it.  q4 = -3pi/4.
#   libero    : LIBERO's init_qpos.  The benchmark overrides the robosuite
#               default, so this is NOT the same as `robosuite` (~41 deg at J6).
#   robosuite : robosuite's default Panda init_qpos.  Kept for reference; not
#               what LIBERO uses.
#
# Values live in gello/robots/franka_fr3.py (FR3_RESET_POSES).
export GELLO_FR3_RESET_POSE=panda
